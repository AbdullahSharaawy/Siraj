      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR14_RunScheduledJobs\nparticipant \&quot;Hangfire Scheduler\&quot; as Hangfire\nparticipant \&quot;CampaignJobService\\n(BLL)\&quot; as CampBLL\nparticipant \&quot;DonationJobService\\n(BLL)\&quot; as DonBLL\nparticipant \&quot;Repository Layer\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\nactor SuperAdmin\n\nHangfire -&gt; Hangfire: Trigger due recurring job(s)\n\nalt Auto-Expire Campaigns\n  Hangfire -&gt; CampBLL: AutoExpireCampaignsJob()\n  CampBLL -&gt; DAL: BulkUpdateExpiredCampaignsAsync()\n  DAL -&gt; DB: UPDATE Campaign SET Status = Expired\n  DB --&gt; DAL: OK\n  DAL --&gt; CampBLL: updatedCount\nelse Delete Old Donations\n  Hangfire -&gt; DonBLL: DeleteOldDonationsJob(thresholdDate)\n  DonBLL -&gt; DAL: DeleteDonationsOlderThanAsync(thresholdDate)\n  DAL -&gt; DB: DELETE Donation WHERE Date &lt; thresholdDate\n  DB --&gt; DAL: OK\n  DAL --&gt; DonBLL: deletedCount\nelse Bulk Delete Expired Campaigns\n  Hangfire -&gt; CampBLL: BulkDeleteExpiredCampaignsJob()\n  CampBLL -&gt; DAL: SoftDeleteExpiredCampaignsAsync()\n  DAL -&gt; DB: UPDATE Campaign SET IsDeleted = true WHERE Status = Expired\n  DB --&gt; DAL: OK\n  DAL --&gt; CampBLL: deletedCount\nend\n\nCampBLL -&gt; CampBLL: LogJobResult()\nDonBLL -&gt; DonBLL: LogJobResult()\n\nalt job execution throws an error\n  Hangfire -&gt; Hangfire: RetryPerConfiguredPolicy()\n  Hangfire -&gt; Hangfire: LogFailure()\nend\n\nSuperAdmin -&gt; Hangfire: GET /hangfire (dashboard)\nHangfire --&gt; SuperAdmin: Job history and status\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fTFpS4ok7qD1qMP60ZkI-1">
