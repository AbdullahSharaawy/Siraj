        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR08_ProcessPaymobCallback\nparticipant \&quot;Paymob Gateway\&quot; as Paymob\nparticipant \&quot;PaymentController\\n(PL)\&quot; as PL\nparticipant \&quot;PaymentService\\n(BLL)\&quot; as PayBLL\nparticipant \&quot;DonationService\\n(BLL)\&quot; as DonBLL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as CampDAL\nparticipant \&quot;DonationRepository\\n(DAL)\&quot; as DonDAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\nPaymob -&gt; PL: POST /api/payments/callback (payload, hmac)\nPL -&gt; PayBLL: HandleCallbackAsync(payload, hmac)\nPayBLL -&gt; PayBLL: VerifyHmacSignature(payload, hmac)\nalt signature invalid\n  PayBLL -&gt; PayBLL: LogSecurityWarning()\n  PayBLL --&gt; PL: Discarded\n  PL --&gt; Paymob: 200 OK\nelse signature valid\n  PayBLL -&gt; PayBLL: CheckPaymentStatus(payload)\n  alt payment failed/declined\n    PayBLL -&gt; PayBLL: LogFailedAttempt()\n    PayBLL --&gt; PL: NoDonationCreated\n    PL --&gt; Paymob: 200 OK\n  else payment succeeded\n    PayBLL -&gt; DonBLL: CreateDonationFromPaymentAsync(userId, campaignId, orgId, amount)\n    DonBLL -&gt; DonDAL: AddDonationAsync(donation)\n    DonDAL -&gt; DB: INSERT Donation\n    DB --&gt; DonDAL: OK\n    DonDAL --&gt; DonBLL: donation created\n    DonBLL -&gt; CampDAL: IncrementCollectedAmountAsync(campaignId, amount)\n    CampDAL -&gt; DB: UPDATE Campaign SET CollectedAmount += amount\n    DB --&gt; CampDAL: OK\n    CampDAL --&gt; DonBLL: updated\n    DonBLL -&gt; DonBLL: CheckSuspiciousThreshold(amount)\n    opt amount exceeds threshold\n      DonBLL -&gt; DonBLL: FlagDonationForReview(donation)\n    end\n    DonBLL --&gt; PayBLL: donation processed\n    PayBLL --&gt; PL: Success\n    PL --&gt; Paymob: 200 OK\n  end\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ILXggHZ2Tr1zOL3gz3Q--1">
