        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR13_TransferItem\nactor Admin\nparticipant \&quot;DonatedItemController\\n(PL)\&quot; as PL\nparticipant \&quot;DonatedItemService\\n(BLL)\&quot; as BLL\nparticipant \&quot;OrganizationRepository\\n(DAL)\&quot; as OrgDAL\nparticipant \&quot;DonatedItemRepository\\n(DAL)\&quot; as ItemDAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\nAdmin -&gt; PL: PUT /api/donated-items/{id}/transfer (targetOrgId)\nPL -&gt; BLL: TransferItemAsync(itemId, targetOrgId)\nBLL -&gt; OrgDAL: GetOrganizationByIdAsync(targetOrgId)\nOrgDAL -&gt; DB: SELECT Organization WHERE Id = targetOrgId AND IsDeleted = false\nDB --&gt; OrgDAL: organization\nOrgDAL --&gt; BLL: organization / null\nalt target organization not found or deleted\n  BLL --&gt; PL: OrganizationNotFoundError\n  PL --&gt; Admin: 404 Not Found\nelse target organization valid\n  BLL -&gt; ItemDAL: UpdateItemOrganizationAsync(itemId, targetOrgId)\n  ItemDAL -&gt; DB: UPDATE DonatedItem SET OrganizationId = targetOrgId\n  DB --&gt; ItemDAL: OK\n  ItemDAL --&gt; BLL: updated\n  BLL -&gt; ItemDAL: LogTransferAsync(itemId, targetOrgId, adminId)\n  ItemDAL -&gt; DB: INSERT TransferLog\n  DB --&gt; ItemDAL: OK\n  ItemDAL --&gt; BLL: logged\n  BLL --&gt; PL: TransferResult(success)\n  PL --&gt; Admin: 200 OK\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="a_OtZlZTVY-zj7mmyXL0-1">
