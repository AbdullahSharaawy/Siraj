  <diagram name="Page-1" id="UU2GcQnBeQ_GFQAMUyrr">
    <mxGraphModel dx="2332" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR17_CampaignCrudLifecycle\nactor \&quot;Organization Admin\&quot; as OrgAdmin\nactor Admin\nparticipant \&quot;CampaignController\\n(PL)\&quot; as PL\nparticipant \&quot;CampaignService\\n(BLL)\&quot; as BLL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Retrieve campaigns ==\nAdmin -&gt; PL: GET /api/campaigns?includeDeleted=&amp;status=&amp;type=&amp;search=\nPL -&gt; BLL: GetCampaignsAsync(filters)\nBLL -&gt; DAL: QueryCampaignsAsync(filters)\nDAL -&gt; DB: SELECT Campaign WHERE ... [AND IsDeleted = false]\nDB --&gt; DAL: campaigns\nDAL --&gt; BLL: campaigns\nBLL --&gt; PL: List&lt;CampaignDto&gt;\nPL --&gt; Admin: 200 OK (list)\n\nAdmin -&gt; PL: GET /api/campaigns/{id}\nPL -&gt; BLL: GetCampaignByIdAsync(id)\nBLL -&gt; DAL: GetByIdAsync(id)\nDAL -&gt; DB: SELECT Campaign WHERE Id = id\nDB --&gt; DAL: campaign\nDAL --&gt; BLL: campaign / null\nalt not found\n  BLL --&gt; PL: NotFoundError\n  PL --&gt; Admin: 404 Not Found\nelse found\n  BLL --&gt; PL: CampaignDto\n  PL --&gt; Admin: 200 OK\nend\n\n== Update campaign ==\nOrgAdmin -&gt; PL: PUT /api/campaigns/{id} (updated fields)\nPL -&gt; BLL: UpdateCampaignAsync(id, dto)\nBLL -&gt; DAL: GetByIdAsync(id)\nDAL -&gt; DB: SELECT Campaign\nDB --&gt; DAL: campaign\nDAL --&gt; BLL: campaign\nBLL -&gt; BLL: ValidateCampaignData(dto)\nalt invalid data or not found\n  BLL --&gt; PL: ValidationError / NotFoundError\n  PL --&gt; OrgAdmin: 400 / 404\nelse valid\n  BLL -&gt; DAL: UpdateAsync(campaign, dto)\n  DAL -&gt; DB: UPDATE Campaign\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: updated\n  BLL --&gt; PL: CampaignDto\n  PL --&gt; OrgAdmin: 200 OK\nend\n\n== Soft delete / restore campaign ==\nAdmin -&gt; PL: DELETE /api/campaigns/{id}\nPL -&gt; BLL: SoftDeleteCampaignAsync(id)\nBLL -&gt; DAL: SoftDeleteAsync(id)\nDAL -&gt; DB: UPDATE Campaign SET IsDeleted = true\nDB --&gt; DAL: OK\nDAL --&gt; BLL: deleted\nBLL --&gt; PL: Success\nPL --&gt; Admin: 200 OK\n\nAdmin -&gt; PL: POST /api/campaigns/{id}/restore\nPL -&gt; BLL: RestoreCampaignAsync(id)\nBLL -&gt; DAL: RestoreAsync(id)\nDAL -&gt; DB: UPDATE Campaign SET IsDeleted = false\nDB --&gt; DAL: OK\nDAL --&gt; BLL: restored\nBLL --&gt; PL: CampaignDto\nPL --&gt; Admin: 200 OK\n\n== Extend deadline ==\nOrgAdmin -&gt; PL: PUT /api/campaigns/{id}/extend-deadline (newDeadline)\nPL -&gt; BLL: ExtendDeadlineAsync(id, newDeadline)\nBLL -&gt; BLL: ValidateNewDeadline(newDeadline)\nalt new deadline not in the future\n  BLL --&gt; PL: ValidationError\n  PL --&gt; OrgAdmin: 400 Bad Request\nelse valid\n  BLL -&gt; DAL: UpdateDeadlineAsync(id, newDeadline)\n  DAL -&gt; DB: UPDATE Campaign SET Deadline = newDeadline\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: updated\n  BLL --&gt; PL: CampaignDto\n  PL --&gt; OrgAdmin: 200 OK\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n3uMHlKC6xg6N0A33WxF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
