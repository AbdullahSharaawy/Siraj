        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR05_CreateCampaign\nactor \&quot;Organization Admin\&quot; as OrgAdmin\nparticipant \&quot;CampaignController\\n(PL)\&quot; as PL\nparticipant \&quot;CampaignService\\n(BLL)\&quot; as BLL\nparticipant \&quot;OrganizationRepository\\n(DAL)\&quot; as OrgDAL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as CampDAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\nOrgAdmin -&gt; PL: POST /api/campaigns (type=Solo|Shared, title, description, target, deadline, orgIds?)\nPL -&gt; BLL: CreateCampaignAsync(dto)\nBLL -&gt; BLL: ValidateCampaignData(dto)\nalt invalid data\n  BLL --&gt; PL: ValidationError\n  PL --&gt; OrgAdmin: 400 Bad Request\nelse valid data\n  alt campaign type == Shared\n    BLL -&gt; OrgDAL: ValidateOrganizationsExistAsync(orgIds)\n    OrgDAL -&gt; DB: SELECT Organization WHERE Id IN (orgIds)\n    DB --&gt; OrgDAL: organizations\n    OrgDAL --&gt; BLL: valid / missing\n    alt an organization is missing\n      BLL --&gt; PL: OrganizationNotFoundError\n      PL --&gt; OrgAdmin: 404 Not Found\n    end\n  end\n  BLL -&gt; CampDAL: AddCampaignAsync(campaign)  &#39; TPH: SoloCampaign or SharedCampaign\n  CampDAL -&gt; DB: INSERT Campaign (discriminator = Solo/Shared)\n  DB --&gt; CampDAL: OK\n  CampDAL --&gt; BLL: campaign created\n  BLL --&gt; PL: CampaignDto\n  PL --&gt; OrgAdmin: 201 Created\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="i8cU4G8CODR3Afoth7e8-1">
