        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR06_AutoExpireCampaigns\nparticipant \&quot;Hangfire Scheduler\&quot; as Hangfire\nparticipant \&quot;Admin\&quot; as Admin\nparticipant \&quot;CampaignController\\n(PL)\&quot; as PL\nparticipant \&quot;CampaignJobService\\n(BLL)\&quot; as BLL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Scheduled trigger ==\nHangfire -&gt; BLL: AutoExpireCampaignsJob()\nBLL -&gt; DAL: GetActiveCampaignsPastDeadlineAsync()\nDAL -&gt; DB: SELECT Campaign WHERE Deadline &lt; Now AND Status = Active\nDB --&gt; DAL: expiredCampaigns\nDAL --&gt; BLL: expiredCampaigns\nalt expired campaigns found\n  BLL -&gt; DAL: BulkUpdateStatusAsync(expiredCampaigns, Expired)\n  DAL -&gt; DB: UPDATE Campaign SET Status = Expired\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: updatedCount\n  BLL -&gt; BLL: LogJobResult(updatedCount)\nelse none found\n  BLL -&gt; BLL: LogJobResult(0, \&quot;No campaigns to expire\&quot;)\nend\n\n== Manual trigger (alternate) ==\nAdmin -&gt; PL: POST /api/campaigns/auto-expire\nPL -&gt; BLL: AutoExpireCampaignsJob()\nnote right: same flow as scheduled trigger\nBLL --&gt; PL: expiredCount\nPL --&gt; Admin: 200 OK (expiredCount)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HUTdLpGDS6-YYfilqINR-1">
