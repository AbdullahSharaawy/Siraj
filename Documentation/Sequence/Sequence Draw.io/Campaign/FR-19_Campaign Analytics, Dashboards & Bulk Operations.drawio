        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR19_CampaignAnalyticsAndBulkOps\nactor Admin\nparticipant \&quot;CampaignController\\n(PL)\&quot; as PL\nparticipant \&quot;CampaignAnalyticsService\\n(BLL)\&quot; as AnalyticsBLL\nparticipant \&quot;CampaignService\\n(BLL)\&quot; as BLL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Analytics &amp; statistics dashboard ==\nAdmin -&gt; PL: GET /api/campaigns/dashboard\nPL -&gt; AnalyticsBLL: GetCampaignDashboardAsync()\nAnalyticsBLL -&gt; DAL: GetCampaignCountsAsync()\nDAL -&gt; DB: SELECT COUNT(*) GROUP BY Type, Status\nDB --&gt; DAL: counts\nDAL --&gt; AnalyticsBLL: counts\nAnalyticsBLL -&gt; DAL: GetTotalRaisedAndAverageAchievementAsync()\nDAL -&gt; DB: SELECT SUM(CollectedAmount), AVG(AchievementPct)\nDB --&gt; DAL: totals\nDAL --&gt; AnalyticsBLL: totals\nAnalyticsBLL -&gt; DAL: GetTopCampaignsAsync()\nDAL -&gt; DB: SELECT TOP N Campaign ORDER BY CollectedAmount/Achievement DESC\nDB --&gt; DAL: topCampaigns\nDAL --&gt; AnalyticsBLL: topCampaigns\nAnalyticsBLL -&gt; DAL: GetRecentAndUrgentCampaignsAsync()\nDAL -&gt; DB: SELECT Campaign ORDER BY CreatedAt DESC / Deadline ASC\nDB --&gt; DAL: recentUrgent\nDAL --&gt; AnalyticsBLL: recentUrgent\nAnalyticsBLL --&gt; PL: CampaignDashboardDto\nPL --&gt; Admin: 200 OK (dashboard)\n\n== Bulk update campaign status ==\nAdmin -&gt; PL: PUT /api/campaigns/bulk-status (campaignIds[], newStatus)\nPL -&gt; BLL: BulkUpdateStatusAsync(campaignIds, newStatus)\nBLL -&gt; DAL: BulkUpdateStatusAsync(campaignIds, newStatus)\nDAL -&gt; DB: UPDATE Campaign SET Status = newStatus WHERE Id IN (campaignIds)\nDB --&gt; DAL: OK\nDAL --&gt; BLL: updatedCount\nBLL --&gt; PL: updatedCount\nPL --&gt; Admin: 200 OK (updatedCount)\n\n== Bulk soft-delete expired campaigns ==\nAdmin -&gt; PL: POST /api/campaigns/bulk-delete-expired\nPL -&gt; BLL: BulkDeleteExpiredCampaignsAsync()\nBLL -&gt; DAL: GetExpiredCampaignsAsync()\nDAL -&gt; DB: SELECT Campaign WHERE Status = Expired\nDB --&gt; DAL: expiredCampaigns\nDAL --&gt; BLL: expiredCampaigns\nBLL -&gt; DAL: BulkSoftDeleteAsync(expiredCampaigns)\nDAL -&gt; DB: UPDATE Campaign SET IsDeleted = true WHERE Id IN (...)\nDB --&gt; DAL: OK\nDAL --&gt; BLL: deletedCount\nBLL --&gt; PL: deletedCount\nPL --&gt; Admin: 200 OK (deletedCount)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UQtiBH1m_LcZeWL57wJj-1">
