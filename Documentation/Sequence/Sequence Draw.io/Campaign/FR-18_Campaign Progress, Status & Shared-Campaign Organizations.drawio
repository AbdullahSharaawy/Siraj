  <diagram name="Page-1" id="admNdozcwPhU9xxVBYPs">
    <mxGraphModel dx="1166" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR18_CampaignProgressAndStatus\nactor \&quot;Organization Admin\&quot; as OrgAdmin\nparticipant \&quot;CampaignController\\n(PL)\&quot; as PL\nparticipant \&quot;CampaignService\\n(BLL)\&quot; as BLL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as DAL\nparticipant \&quot;OrganizationRepository\\n(DAL)\&quot; as OrgDAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Update campaign status ==\nOrgAdmin -&gt; PL: PUT /api/campaigns/{id}/status (newStatus)\nPL -&gt; BLL: UpdateCampaignStatusAsync(id, newStatus)\nBLL -&gt; BLL: ValidateStatusTransition(currentStatus, newStatus)\nalt invalid transition\n  BLL --&gt; PL: ValidationError\n  PL --&gt; OrgAdmin: 400 Bad Request\nelse valid\n  BLL -&gt; DAL: UpdateStatusAsync(id, newStatus)\n  DAL -&gt; DB: UPDATE Campaign SET Status = newStatus\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: updated\n  BLL --&gt; PL: CampaignDto\n  PL --&gt; OrgAdmin: 200 OK\nend\n\n== Increment collected money (called from Make Donation, FR-07/08) ==\nBLL -&gt; DAL: IncrementCollectedAmountAsync(campaignId, amount)\nDAL -&gt; DB: UPDATE Campaign SET CollectedAmount += amount\nDB --&gt; DAL: OK\nDAL --&gt; BLL: updated\nBLL -&gt; BLL: RecalculateAchievementPercentage()\n\n== Manage shared campaign organizations ==\nOrgAdmin -&gt; PL: POST /api/campaigns/{id}/organizations (orgId)\nPL -&gt; BLL: AddOrganizationToSharedCampaignAsync(campaignId, orgId)\nBLL -&gt; OrgDAL: GetOrganizationByIdAsync(orgId)\nOrgDAL -&gt; DB: SELECT Organization\nDB --&gt; OrgDAL: organization\nOrgDAL --&gt; BLL: organization / null\nalt organization not found\n  BLL --&gt; PL: NotFoundError\n  PL --&gt; OrgAdmin: 404 Not Found\nelse found\n  BLL -&gt; DAL: LinkOrganizationToCampaignAsync(campaignId, orgId)\n  DAL -&gt; DB: INSERT SharedCampaignOrganization\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: linked\n  BLL --&gt; PL: Success\n  PL --&gt; OrgAdmin: 200 OK\nend\n\nOrgAdmin -&gt; PL: DELETE /api/campaigns/{id}/organizations/{orgId}\nPL -&gt; BLL: RemoveOrganizationFromSharedCampaignAsync(campaignId, orgId)\nBLL -&gt; DAL: UnlinkOrganizationFromCampaignAsync(campaignId, orgId)\nDAL -&gt; DB: DELETE SharedCampaignOrganization\nDB --&gt; DAL: OK\nDAL --&gt; BLL: unlinked\nBLL --&gt; PL: Success\nPL --&gt; OrgAdmin: 200 OK\n\nOrgAdmin -&gt; PL: GET /api/campaigns/{id}/organizations/count\nPL -&gt; BLL: GetOrganizationCountAsync(campaignId)\nBLL -&gt; DAL: CountOrganizationsForCampaignAsync(campaignId)\nDAL -&gt; DB: SELECT COUNT(*) FROM SharedCampaignOrganization WHERE CampaignId = id\nDB --&gt; DAL: count\nDAL --&gt; BLL: count\nBLL --&gt; PL: count\nPL --&gt; OrgAdmin: 200 OK (count)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="j2gjP3If7h916dF-q3O2-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
