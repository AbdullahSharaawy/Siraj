        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR23_CampaignAndUserDonationQueries\nactor \&quot;Organization Admin\&quot; as Actor\nparticipant \&quot;DonationController\\n(PL)\&quot; as PL\nparticipant \&quot;DonationService\\n(BLL)\&quot; as BLL\nparticipant \&quot;DonationRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Campaign &amp;&amp; User specific queries ==\n\nActor -&gt; PL: GET /api/campaigns/{id}/donors\nPL -&gt; BLL: GetCampaignDonorsAndTimelineAsync(campaignId)\nBLL -&gt; DAL: GetDonorsByCampaignAsync(campaignId)\nDAL -&gt; DB: SELECT DISTINCT Donation.UserId, Date WHERE CampaignId = id ORDER BY Date\nDB --&gt; DAL: donorsTimeline\nDAL --&gt; BLL: donorsTimeline\nBLL --&gt; PL: List&lt;DonorTimelineDto&gt;\nPL --&gt; Actor: 200 OK (donors + timeline)\n\n== User-specific queries ==\nActor -&gt; PL: GET /api/users/{id}/donations\nPL -&gt; BLL: GetUserDonationHistoryAsync(userId)\nBLL -&gt; DAL: GetByUserIdAsync(userId)\nDAL -&gt; DB: SELECT Donation WHERE UserId = id ORDER BY Date DESC\nDB --&gt; DAL: donations\nDAL --&gt; BLL: donations\nBLL --&gt; PL: List&lt;DonationDto&gt;\nPL --&gt; Actor: 200 OK (history)\n\nActor -&gt; PL: GET /api/users/{id}/donations/last-date\nPL -&gt; BLL: GetLastDonationDateAsync(userId)\nBLL -&gt; DAL: GetLastDonationDateAsync(userId)\nDAL -&gt; DB: SELECT MAX(Date) WHERE UserId = id\nDB --&gt; DAL: lastDate\nDAL --&gt; BLL: lastDate\nBLL --&gt; PL: lastDate\nPL --&gt; Actor: 200 OK (last donation date)\n\nActor -&gt; PL: GET /api/users/{id}/campaigns-donated-to\nPL -&gt; BLL: GetCampaignsDonatedToAsync(userId)\nBLL -&gt; DAL: GetDistinctCampaignsByUserAsync(userId)\nDAL -&gt; DB: SELECT DISTINCT CampaignId WHERE UserId = id\nDB --&gt; DAL: campaignIds\nDAL --&gt; BLL: campaigns\nBLL --&gt; PL: List&lt;CampaignDto&gt;\nPL --&gt; Actor: 200 OK (campaigns)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="r2C-iS2ZEXo2ROsIdM96-22">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
