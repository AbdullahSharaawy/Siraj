        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR02_ConfirmEmail\nactor Guest\nparticipant \&quot;AuthController\\n(PL)\&quot; as PL\nparticipant \&quot;UserService\\n(BLL)\&quot; as BLL\nparticipant \&quot;UserRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\nGuest -&gt; PL: GET /api/auth/confirm-email?userId&amp;token\nPL -&gt; BLL: ConfirmEmailAsync(userId, token)\nBLL -&gt; DAL: GetUserByIdAsync(userId)\nDAL -&gt; DB: SELECT User\nDB --&gt; DAL: user\nDAL --&gt; BLL: user\nBLL -&gt; BLL: ValidateToken(user, token)\nalt token invalid or expired\n  BLL --&gt; PL: InvalidTokenError\n  PL --&gt; Guest: 400 Bad Request\nelse token valid\n  BLL -&gt; DAL: SetEmailConfirmedAsync(userId)\n  DAL -&gt; DB: UPDATE User SET EmailConfirmed = true\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: confirmed\n  BLL --&gt; PL: ConfirmResult(success)\n  PL --&gt; Guest: 200 OK\nend\n\nalt user requests resend\n  Guest -&gt; PL: POST /api/auth/resend-confirmation (email)\n  PL -&gt; BLL: ResendConfirmationAsync(email)\n  BLL -&gt; DAL: GetUserByEmailAsync(email)\n  DAL -&gt; DB: SELECT User\n  DB --&gt; DAL: user\n  DAL --&gt; BLL: user\n  BLL -&gt; BLL: GenerateEmailConfirmationToken()\n  BLL -&gt; PL: (delegates to EmailService, omitted for brevity)\n  PL --&gt; Guest: 200 OK\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FIt6BVseGzNORhi5RoLs-1">
