        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR03_Login\nactor Guest\nparticipant \&quot;AuthController\\n(PL)\&quot; as PL\nparticipant \&quot;UserService\\n(BLL)\&quot; as BLL\nparticipant \&quot;UserRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\nparticipant \&quot;JwtTokenGenerator\&quot; as JWT\n\nGuest -&gt; PL: POST /api/auth/login (usernameOrEmail, password)\nPL -&gt; BLL: LoginAsync(dto)\nBLL -&gt; DAL: GetUserByUsernameOrEmailAsync()\nDAL -&gt; DB: SELECT User\nDB --&gt; DAL: user\nDAL --&gt; BLL: user\nBLL -&gt; BLL: VerifyPasswordHash(password)\nalt invalid credentials\n  BLL --&gt; PL: AuthenticationError\n  PL --&gt; Guest: 401 Unauthorized\nelse valid credentials\n  BLL -&gt; BLL: CheckEmailConfirmed(user)\n  alt email not confirmed\n    BLL --&gt; PL: EmailNotConfirmedError\n    PL --&gt; Guest: 403 Forbidden\n  else confirmed\n    BLL -&gt; JWT: GenerateToken(user, roles)\n    JWT --&gt; BLL: jwtToken\n    BLL --&gt; PL: LoginResult(token)\n    PL --&gt; Guest: 200 OK (JWT)\n  end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XdJUCFOiWuIKhcTf1Jbl-1">
