        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR04_ResetPassword\nactor \&quot;Guest / Donor\&quot; as User\nparticipant \&quot;AuthController\\n(PL)\&quot; as PL\nparticipant \&quot;UserService\\n(BLL)\&quot; as BLL\nparticipant \&quot;UserRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\nparticipant \&quot;EmailService\&quot; as Email\n\n== Request reset ==\nUser -&gt; PL: POST /api/auth/forgot-password (email)\nPL -&gt; BLL: RequestPasswordResetAsync(email)\nBLL -&gt; DAL: GetUserByEmailAsync(email)\nDAL -&gt; DB: SELECT User\nDB --&gt; DAL: user\nDAL --&gt; BLL: user\nBLL -&gt; BLL: GenerateResetToken()\nBLL -&gt; Email: SendPasswordResetEmail(email, token)\nEmail --&gt; BLL: sent\nBLL --&gt; PL: OK\nPL --&gt; User: 200 OK\n\n== Reset password ==\nUser -&gt; PL: POST /api/auth/reset-password (token, newPassword)\nPL -&gt; BLL: ResetPasswordAsync(token, newPassword)\nBLL -&gt; BLL: ValidateToken() / ValidatePasswordComplexity()\nalt token invalid/expired or password weak\n  BLL --&gt; PL: ValidationError\n  PL --&gt; User: 400 Bad Request\nelse valid\n  BLL -&gt; DAL: UpdatePasswordAsync(userId, newPasswordHash)\n  DAL -&gt; DB: UPDATE User SET PasswordHash\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: updated\n  BLL -&gt; Email: SendPasswordChangedNotification(email)\n  Email --&gt; BLL: sent\n  BLL --&gt; PL: OK\n  PL --&gt; User: 200 OK\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pstD0hoId4VXV9igpgNo-1">
