        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR01_Register\nactor Guest\nparticipant \&quot;AuthController\\n(PL)\&quot; as PL\nparticipant \&quot;UserService\\n(BLL)\&quot; as BLL\nparticipant \&quot;UserRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\nparticipant \&quot;EmailService\&quot; as Email\n\nGuest -&gt; PL: POST /api/auth/register (email, username, password, fullName, phone, address)\nPL -&gt; BLL: RegisterAsync(dto)\nBLL -&gt; BLL: ValidatePasswordComplexity()\nalt password invalid\n  BLL --&gt; PL: ValidationError\n  PL --&gt; Guest: 400 Bad Request\nelse password valid\n  BLL -&gt; DAL: ExistsByEmailOrUsernameAsync()\n  DAL -&gt; DB: SELECT User WHERE email/username\n  DB --&gt; DAL: result\n  DAL --&gt; BLL: exists?\n  alt already registered\n    BLL --&gt; PL: ConflictError\n    PL --&gt; Guest: 409 Conflict\n  else new user\n    BLL -&gt; DAL: AddUserAsync(user, unconfirmed)\n    DAL -&gt; DB: INSERT User\n    DB --&gt; DAL: OK\n    DAL --&gt; BLL: user created\n    BLL -&gt; BLL: GenerateEmailConfirmationToken()\n    BLL -&gt; Email: SendConfirmationEmail(user.Email, token)\n    Email --&gt; BLL: sent\n    BLL --&gt; PL: RegisterResult(success)\n    PL --&gt; Guest: 201 Created\n  end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fPdIMcp6GErFpv_VIHvv-1">
