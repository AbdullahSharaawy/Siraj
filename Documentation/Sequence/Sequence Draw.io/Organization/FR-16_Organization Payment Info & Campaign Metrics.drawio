        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR16_OrganizationMetricsAndPaymentInfo\nactor \&quot;Organization Admin\&quot; as OrgAdmin\nactor Admin\nparticipant \&quot;OrganizationController\\n(PL)\&quot; as PL\nparticipant \&quot;OrganizationService\\n(BLL)\&quot; as BLL\nparticipant \&quot;PaymentInfoRepository\\n(DAL)\&quot; as PayDAL\nparticipant \&quot;OrganizationRepository\\n(DAL)\&quot; as OrgDAL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as CampDAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Manage Paymob API keys ==\nOrgAdmin -&gt; PL: POST /api/organizations/{id}/payment-info (paymobApiKey)\nPL -&gt; BLL: SetPaymentInfoAsync(orgId, dto)\nBLL -&gt; BLL: ValidateApiKeyFormat(dto)\nalt invalid key\n  BLL --&gt; PL: ValidationError\n  PL --&gt; OrgAdmin: 400 Bad Request\nelse valid key\n  BLL -&gt; PayDAL: UpsertPaymentInfoAsync(orgId, apiKey)\n  PayDAL -&gt; DB: INSERT/UPDATE PaymentInfo\n  DB --&gt; PayDAL: OK\n  PayDAL --&gt; BLL: saved\n  BLL --&gt; PL: PaymentInfoDto (last updated timestamp)\n  PL --&gt; OrgAdmin: 200 OK\nend\n\n== Organization campaign metrics ==\nAdmin -&gt; PL: GET /api/organizations/metrics\nPL -&gt; BLL: GetOrganizationMetricsAsync()\nBLL -&gt; OrgDAL: GetAllOrganizationsAsync()\nOrgDAL -&gt; DB: SELECT Organization\nDB --&gt; OrgDAL: organizations\nOrgDAL --&gt; BLL: organizations\nBLL -&gt; CampDAL: GetCampaignCountsByOrganizationAsync()\nCampDAL -&gt; DB: SELECT COUNT(*) FROM Campaign GROUP BY OrganizationId\nDB --&gt; CampDAL: campaignCounts\nCampDAL --&gt; BLL: campaignCounts\nBLL -&gt; BLL: IdentifyOrgsWithActiveCampaigns()\nBLL -&gt; BLL: IdentifyOrgsWithCompletedCampaigns()\nBLL -&gt; BLL: IdentifyOrgsWithoutCampaigns()\nBLL --&gt; PL: OrganizationMetricsDto\nPL --&gt; Admin: 200 OK (metrics)\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5U9PFJJEkiwTWTioqu6j-127">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
