        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR10_ManageContactMethods\nactor \&quot;Organization Admin\&quot; as OrgAdmin\nparticipant \&quot;OrganizationController\\n(PL)\&quot; as PL\nparticipant \&quot;OrganizationService\\n(BLL)\&quot; as BLL\nparticipant \&quot;ContactMethodRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\nOrgAdmin -&gt; PL: GET /api/organizations/{id}/contact-methods\nPL -&gt; BLL: GetContactMethodsAsync(orgId)\nBLL -&gt; DAL: GetByOrganizationIdAsync(orgId)\nDAL -&gt; DB: SELECT OrganizationContactMethod\nDB --&gt; DAL: contactMethods\nDAL --&gt; BLL: contactMethods\nBLL --&gt; PL: list\nPL --&gt; OrgAdmin: 200 OK (list)\n\nOrgAdmin -&gt; PL: POST /api/organizations/{id}/contact-methods (type, value)\nPL -&gt; BLL: CreateContactMethodAsync(orgId, dto)\nBLL -&gt; BLL: ValidateContactMethodType(type)\nalt unsupported type\n  BLL --&gt; PL: ValidationError\n  PL --&gt; OrgAdmin: 400 Bad Request\nelse valid\n  BLL -&gt; DAL: AddContactMethodAsync(orgId, dto)\n  DAL -&gt; DB: INSERT OrganizationContactMethod\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: created\n  BLL --&gt; PL: ContactMethodDto\n  PL --&gt; OrgAdmin: 201 Created\nend\n\nnote over OrgAdmin, DAL\n  Update / Delete (soft) / Restore follow the same\n  Controller -&gt; Service -&gt; Repository -&gt; DB pattern.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OruPD1KzGE3Zbpif-QHa-1">
