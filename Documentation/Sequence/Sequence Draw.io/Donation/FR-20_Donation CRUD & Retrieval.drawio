      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR20_DonationCrud\nactor Admin\nparticipant \&quot;DonationController\\n(PL)\&quot; as PL\nparticipant \&quot;DonationService\\n(BLL)\&quot; as BLL\nparticipant \&quot;DonationRepository\\n(DAL)\&quot; as DAL\ndatabase \&quot;TheCharityDB\&quot; as DB\n\n== Retrieve all / by ID ==\nAdmin -&gt; PL: GET /api/donations?includeDeleted=\nPL -&gt; BLL: GetDonationsAsync(includeDeleted)\nBLL -&gt; DAL: GetAllAsync(includeDeleted)\nDAL -&gt; DB: SELECT Donation [WHERE IsDeleted = false]\nDB --&gt; DAL: donations\nDAL --&gt; BLL: donations\nBLL --&gt; PL: List&lt;DonationDto&gt;\nPL --&gt; Admin: 200 OK (list)\n\nAdmin -&gt; PL: GET /api/donations/{id}/details\nPL -&gt; BLL: GetDonationDetailsAsync(id)\nBLL -&gt; DAL: GetByIdWithDetailsAsync(id)\nDAL -&gt; DB: SELECT Donation JOIN User, Campaign WHERE Id = id\nDB --&gt; DAL: donation\nDAL --&gt; BLL: donation / null\nalt not found\n  BLL --&gt; PL: NotFoundError\n  PL --&gt; Admin: 404 Not Found\nelse found\n  BLL --&gt; PL: DonationDetailsDto\n  PL --&gt; Admin: 200 OK\nend\n\n== Create / update ==\nAdmin -&gt; PL: POST /api/donations (manual entry, campaignId, userId, amount)\nPL -&gt; BLL: CreateDonationAsync(dto)\nBLL -&gt; BLL: ValidateDonationData(dto)\nalt invalid\n  BLL --&gt; PL: ValidationError\n  PL --&gt; Admin: 400 Bad Request\nelse valid\n  BLL -&gt; DAL: AddAsync(donation)\n  DAL -&gt; DB: INSERT Donation\n  DB --&gt; DAL: OK\n  DAL --&gt; BLL: created\n  BLL --&gt; PL: DonationDto\n  PL --&gt; Admin: 201 Created\nend\n\nAdmin -&gt; PL: PUT /api/donations/{id} (updated fields)\nPL -&gt; BLL: UpdateDonationAsync(id, dto)\nBLL -&gt; DAL: GetByIdAsync(id)\nDAL -&gt; DB: SELECT Donation\nDB --&gt; DAL: donation\nDAL --&gt; BLL: donation\nBLL -&gt; DAL: UpdateAsync(donation, dto)\nDAL -&gt; DB: UPDATE Donation\nDB --&gt; DAL: OK\nDAL --&gt; BLL: updated\nBLL --&gt; PL: DonationDto\nPL --&gt; Admin: 200 OK\n\n== Soft delete / restore ==\nAdmin -&gt; PL: DELETE /api/donations/{id}\nPL -&gt; BLL: SoftDeleteDonationAsync(id)\nBLL -&gt; DAL: SoftDeleteAsync(id)\nDAL -&gt; DB: UPDATE Donation SET IsDeleted = true\nDB --&gt; DAL: OK\nDAL --&gt; BLL: deleted\nBLL --&gt; PL: Success\nPL --&gt; Admin: 200 OK\n\nAdmin -&gt; PL: POST /api/donations/{id}/restore\nPL -&gt; BLL: RestoreDonationAsync(id)\nBLL -&gt; DAL: RestoreAsync(id)\nDAL -&gt; DB: UPDATE Donation SET IsDeleted = false\nDB --&gt; DAL: OK\nDAL --&gt; BLL: restored\nBLL --&gt; PL: DonationDto\nPL --&gt; Admin: 200 OK\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hGjXySvQcTwTxFCtMFcy-1">
