        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml FR07_MakeDonation\nactor Donor\nparticipant \&quot;DonationController\\n(PL)\&quot; as PL\nparticipant \&quot;DonationService\\n(BLL)\&quot; as BLL\nparticipant \&quot;CampaignRepository\\n(DAL)\&quot; as CampDAL\nparticipant \&quot;PaymentService\\n(BLL)\&quot; as PayBLL\nparticipant \&quot;Paymob API\&quot; as Paymob\ndatabase \&quot;TheCharityDB\&quot; as DB\n\nDonor -&gt; PL: POST /api/donations (campaignId, amount)\nPL -&gt; BLL: InitiateDonationAsync(dto)\nBLL -&gt; CampDAL: GetCampaignByIdAsync(campaignId)\nCampDAL -&gt; DB: SELECT Campaign\nDB --&gt; CampDAL: campaign\nCampDAL --&gt; BLL: campaign\nBLL -&gt; BLL: ValidateCampaignActiveAndAmount()\nalt invalid campaign/amount\n  BLL --&gt; PL: ValidationError\n  PL --&gt; Donor: 400 Bad Request\nelse valid\n  BLL -&gt; PayBLL: CreatePaymentRequestAsync(user, campaign, organization, amount)\n  PayBLL -&gt; Paymob: POST /payment (metadata)\n  Paymob --&gt; PayBLL: paymentKey / redirectUrl\n  PayBLL --&gt; BLL: paymentUrl\n  BLL --&gt; PL: PendingPaymentResult(paymentUrl)\n  PL --&gt; Donor: 200 OK (redirect to Paymob)\n\n  Donor -&gt; Paymob: Completes payment on hosted page\n  note over Paymob: See FR-08 (Process Paymob Callback)\\nfor donation-record creation\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NgAm6HMNlPpZ6h_BtjUE-1">
